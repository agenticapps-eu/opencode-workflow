# OpenSpec CLI-generated command/skill surface — regenerated by
# `openspec init --tools opencode --profile core` (bind-upstream, spec §16).
# The durable slot (openspec/specs, openspec/changes) is committed; these
# per-project command wrappers are build output, not hand-maintained.
.opencode/commands/opsx-*.md
.opencode/skills/openspec-*/

# Core's artifacts are PINNED, not vendored (ADR-0013). bin/ is a cache
# regenerated from tools/core-vendor.manifest by bin/materialise-core-artifacts.sh
# and hash-verified against it. Never committed: a committed copy is a copy that
# drifts, and these two spent a release stale at gate 1.3.1 / wrapper 1.1.0
# while core shipped 2.0.0 / 1.2.0.
bin/openspec-change-gate.sh
bin/reviewer-cli.sh
