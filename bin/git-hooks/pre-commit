#!/usr/bin/env bash
# pre-commit — agent-agnostic floor for the §18 OpenSpec change-gate (opencode host).
#
# Adapted from the core reference implementation's `pre-commit` wrapper
# (agenticapps-workflow-core reference-implementations/openspec-change-gate/).
# Host-local, NOT byte-identical to core: it adds this repo's gate-path fallback
# and exports OPENSPEC_GATE_SELF=opencode so this host's own reviews do not count
# toward the reviewer threshold (§18). All policy — staged-awareness, the
# openspec/ artifact exemption, validate + REVIEWS.md >=2, the escape hatch — lives
# in the vendored gate's `--pre-commit` mode, not here.
#
# Why the floor exists: the per-agent hooks (Claude PreToolUse, the opencode
# plugin, Codex hooks.json) are each loaded at session start and cannot gate the
# session that installed them; none exists for a human with an editor. This git
# hook catches code committed by ANY agent or a human, including the installing
# session.
#
# Bypass (documented, same posture as the per-agent escape hatch):
#   GSD_SKIP_REVIEWS=1 git commit ...      # deliberate, logged override
#   git commit --no-verify ...             # git's own bypass
#
# Resolution order for the gate script. The shared install path is preferred so a
# single upgrade reaches every repo; issue #32/#15 recorded its failure mode
# (whichever host's installer ran last owns that path), so pin OPENSPEC_CHANGE_GATE
# to a known-good copy to opt out of that race, and score whatever you land on:
#   tools/change-gate-conformance.sh "$OPENSPEC_CHANGE_GATE"
set -u

export OPENSPEC_GATE_SELF="${OPENSPEC_GATE_SELF:-opencode}"

GATE=""
for c in "${OPENSPEC_CHANGE_GATE:-}" \
         "$HOME/.agenticapps/bin/openspec-change-gate.sh" \
         "$(git rev-parse --show-toplevel 2>/dev/null)/bin/openspec-change-gate.sh"; do
  [ -n "$c" ] && [ -x "$c" ] && { GATE="$c"; break; }
done

# Fail OPEN on a missing gate, consistent with §18's fail-open-on-error posture:
# a commit hook that hard-fails because tooling is absent trains people to pass
# --no-verify, which disables the floor permanently. The CI check still runs.
if [ -z "$GATE" ]; then
  printf 'openspec-gate: WARNING — gate not found; commit not gated.\n' >&2
  exit 0
fi

exec "$GATE" --pre-commit
